---
layout: base.njk
---
<article class="max-w-3xl px-6 py-16 mx-auto delay-100 sm:px-12 scroll-reveal">
  <!-- Manuscript Header Box -->
  <header class="p-8 mb-12 space-y-4 text-center border rounded-lg bg-theme-elevated border-theme-border/80 sm:p-10">
    <h1 class="text-3xl font-bold leading-tight font-jura sm:text-5xl text-theme-title">
      {{ title }}
    </h1>
    {% if author %}
      <div class="w-12 h-[1px] bg-theme-gold/50 mx-auto my-3"></div>
      <p class="text-base font-jura sm:text-lg text-theme-gold">
        {{ author }} {% if year %}<span class="font-normal text-theme-muted">({{ year }} H)</span>{% endif %}
      </p>
    {% endif %}
  </header>

  <!-- Manuscript Body Content -->
  <div class="space-y-6 text-base leading-loose prose prose-invert max-w-none font-jura text-theme-title sm:text-lg">
    {{ content | safe }}
  </div>

  <footer class="pt-8 mt-16 border-t border-theme-border/60">
    <a href="/#books" class="inline-flex items-center gap-2 font-jura text-xs uppercase tracking-[0.2em] text-theme-gold border border-theme-gold/30 px-6 py-3 rounded hover:bg-theme-gold/10 hover:border-theme-gold transition-colors">
      &larr; Kthehu te Katalogu
    </a>
  </footer>
</article>