{
  "name": "arkivi-selefi",
  "version": "1.0.0",
  "description": "Literature catalog web application",
  "main": ".eleventy.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/styles/main.css -o ./public/main.css --minify",
    "watch:css": "tailwindcss -i ./src/styles/main.css -o ./public/main.css --watch",
    "build": "npm run build:css && eleventy",
    "start": "concurrently \"npm run watch:css\" \"eleventy --serve\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3"
  }
}
