---
layout: base.njk
---
<article class="max-w-3xl px-6 py-16 mx-auto delay-100 sm:px-12 scroll-reveal">
  <!-- Header -->
  <header class="pb-10 mb-12 space-y-4 text-center border-b border-theme-border/60">
    <h1 class="text-4xl font-bold leading-tight font-jura sm:text-6xl text-theme-title">
      {{ title }}
    </h1>
    {% if author %}
      <p class="pt-1 text-base font-jura sm:text-lg text-theme-gold">
        {{ author }} {% if year %}<span class="font-normal text-theme-muted">({{ year }})</span>{% endif %}
      </p>
    {% endif %}
  </header>

  <!-- Content Card Deck -->
  <div class="space-y-4 text-base leading-relaxed font-jura text-theme-title sm:text-lg">
    {{ content | safe }}
  </div>

</article>