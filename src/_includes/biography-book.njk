---
layout: base.njk
---
<article class="max-w-3xl px-6 py-16 mx-auto delay-100 sm:px-12 scroll-reveal">
  <header class="pb-8 mb-10 space-y-4 border-b border-theme-border/60">
    <h1 class="text-4xl font-bold leading-tight font-jura sm:text-6xl text-theme-title">
      {{ title }}
    </h1>
    {% if author %}
      <p class="text-base font-jura sm:text-lg text-theme-gold">
        Përgatitur nga: {{ author }} {% if year %}<span class="font-normal text-theme-muted">({{ year }})</span>{% endif %}
      </p>
    {% endif %}
  </header>

  <div class="space-y-6 text-base leading-relaxed prose prose-invert max-w-none font-jura text-theme-title sm:text-lg">
    {{ content | safe }}
  </div>

</article>